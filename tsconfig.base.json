{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {
      "@sgip/types/*": ["./types/*"],
      "@sgip/schemas/*": ["./schemas/*"],
      "@sgip/contracts/*": ["./contracts/*"],
      "@sgip/shared/*": ["./shared/*"],
      "@sgip/graph/*": ["./graph/*"],
      "@sgip/core/*": ["./core/*"]
    }
  },
  "include": [
    "types/**/*",
    "schemas/**/*",
    "contracts/**/*",
    "shared/**/*",
    "graph/**/*",
    "core/**/*",
    "orchestration/**/*",
    "governance-memory/**/*",
    "audit/**/*",
    "agents/**/*",
    "modules/**/*"
  ],
  "exclude": ["node_modules", "dist", "ui-shell"]
}
