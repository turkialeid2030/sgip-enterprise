# ── SGIP environment contract ────────────────────────────────
# Every variable below is REQUIRED in production. Compose fails fast if unset.

# PostgreSQL bootstrap superuser (creates roles + extensions ONLY at init time).
# The API never uses this account.
POSTGRES_USER=sgip_bootstrap
POSTGRES_PASSWORD=            # REQUIRED — no default
POSTGRES_DB=sgip_prod

# Role model (created by infra/postgres/05-create-roles.sh)
#   sgip_owner    — owns the schema. NOLOGIN, NOSUPERUSER, NOBYPASSRLS.
#                   Must NOT be a superuser: FORCE RLS contains an owner,
#                   but a superuser bypasses RLS regardless.
#   sgip_migrator — DDL/migrations only. LOGIN.
#   sgip_app      — runtime. LOGIN, DML only, NOSUPERUSER, NOBYPASSRLS, no ownership.
# Use a DIFFERENT password per login role in production.
APP_DB_PASSWORD=              # REQUIRED — password for sgip_app
MIGRATOR_DB_PASSWORD=         # REQUIRED — password for sgip_migrator

# The API connects as sgip_app — never as an owner/admin account.
DATABASE_URL=postgresql://sgip_app:${APP_DB_PASSWORD}@postgres:5432/sgip_prod

# Persistence mode. 'postgres' (default) fails closed when the DB is down.
# 'memory' is permitted ONLY for local development and tests.
PERSISTENCE_MODE=postgres

# Startup
NODE_ENV=production
PORT=4000
DB_WAIT_MS=15000              # how long startup waits for the database

# Auth
JWT_SECRET=                   # REQUIRED — no default
JWT_REFRESH_SECRET=           # REQUIRED — no default
JWT_EXPIRES_IN=8h

# Optional integrations
KAFKA_BROKERS=
OTEL_EXPORTER_OTLP_ENDPOINT=
