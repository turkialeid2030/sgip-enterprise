{
  "name": "@sgip/enterprise",
  "version": "1.0.0",
  "description": "SGIP — Sovereign Governance Intelligence Platform — Enterprise Architecture",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "dev": "tsx watch api/server.ts",
    "start": "node dist/api/server.js",
    "start:prod": "node dist/api/server.js",
    "db:migrate": "node -e \"console.error('BLOCKED: prisma migrate is the LEGACY path. Authoritative source is db/migrations — use npm run db:apply.');process.exit(1)\"",
    "db:migrate:prod": "node -e \"console.error('BLOCKED: prisma migrate is the LEGACY path. Authoritative source is db/migrations — use npm run db:apply.');process.exit(1)\"",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "node -e \"console.error('BLOCKED: Prisma Studio is a LEGACY path; SGIP production persistence uses native pg and db/migrations.');process.exit(1)\"",
    "db:generate": "node -e \"console.error('BLOCKED: Prisma Client generation is not used; SGIP runtime persistence uses native pg.');process.exit(1)\"",
    "setup": "npm install && npm run db:apply && ts-node prisma/seed.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f api",
    "db:apply": "bash infra/postgres/10-apply-migrations.sh",
    "verify:error-contract:static": "node scripts/verify-error-contract-static.cjs",
    "verify:deployment": "node scripts/verify-deployment-readiness.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^3.0.0",
    "dotenv": "^17.4.2",
    "eventemitter3": "^5.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "morgan": "^1.10.1",
    "pg": "^8.21.0",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.41",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.2",
    "typescript": "^5.9.3"
  }
}
